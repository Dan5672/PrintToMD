<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:printsupport2="http://schemas.microsoft.com/appx/manifest/printsupport/windows10/2"
  IgnorableNamespaces="uap uap10 mp printsupport2">

  <Identity Name="FriskeLabs.Print2MD" Publisher="CN=7A2E1264-EDC4-4728-A5BD-D1FAC5534E2B" Version="1.1.0.0" />
  <mp:PhoneIdentity PhoneProductId="f40b9a2e-dd6a-4e74-b44a-ce390ace5088" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Print2MD</DisplayName>
    <PublisherDisplayName>FriskeLabs</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="$targetnametoken$.exe"
                 EntryPoint="Print2Md.App.App"
                 uap10:RuntimeBehavior="windowsApp"
                 uap10:TrustLevel="appContainer"
                 uap10:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Print2MD"
        Description="Convert printed documents to readable Markdown"
        BackgroundColor="#263238"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#263238" />
      </uap:VisualElements>

      <Extensions>
        <printsupport2:Extension
          Category="windows.printSupportVirtualPrinterWorkflow"
          EntryPoint="Print2Md.Tasks.VirtualPrinterBackgroundTask">
          <printsupport2:PrintSupportVirtualPrinter
            DisplayName="ms-resource:///Resources/PrinterDisplayName"
            PrinterUri="print2md:print-to-markdown"
            PreferredInputFormat="application/oxps"
            OutputFileTypes="md"
            PdcFile="Config\PrinterPdc.xml">
            <printsupport2:SupportedFormats>
              <printsupport2:SupportedFormat Type="application/oxps" />
              <printsupport2:SupportedFormat Type="application/pdf" MaxVersion="1.7" />
            </printsupport2:SupportedFormats>
          </printsupport2:PrintSupportVirtualPrinter>
        </printsupport2:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities />
</Package>
